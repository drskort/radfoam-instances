.vscode
/.venv/
/.venv-sam*/
/external/sam_backends/
/build*/
/dist/
/data
/radfoam/
/*output*
/work

*.egg-info
__pycache__
/*nsight
*.ipynb
.ipynb_checkpoints/

# Slurm logs -- every job in this repo writes one to the root.
*.log

# Scratch: throwaway probes, one-off diagnostics, deck-building scripts.
/.scratch/

# Local working notes and decks: shared out of band, not part of the method.
/docs/

# MasQCLIP weights: 1.5 GB each, from the MasQCLIP release, not ours to ship.
ckpts/

# PLY scene exports are build artefacts of a checkpoint.
*.ply

# Compiled extension: built by `pip install -e .`, not source.
/src/radfoam/

# Checkpoints: written to output/, never versioned.
*.pt
*.pth
third_party/masqclip.py
