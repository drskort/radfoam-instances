# Decks and their sources are shared out of band, not versioned (tens of MB).
docs/*.pptx

# Planning notes from the assistant workflow, not part of the method.
docs/

# MasQCLIP weights: 1.5 GB each, from the MasQCLIP release, not ours to ship.
ckpts/

# foamviz scene exports and PLYs are build artefacts of a checkpoint.
*.ply

# Compiled extension: built by `pip install -e .`, not source.
/src/radfoam/
